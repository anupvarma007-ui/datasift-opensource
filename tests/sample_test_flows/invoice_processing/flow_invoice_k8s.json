{
  "flow": {
    "name": "invoice processing flow k8s",
    "flow_id": "55578a6c-96b0-4f51-af8f-3aa63c575142",
    "description": "Invoice processing flow with Kubernetes distributed execution",
    "storage": "in-memory",
    "execute_type": "local",
    "global_config": {
      "doc_column": "content",
      "disable_validation": "true",
      "force_ingest": true,
      "enable_micro_batching": true,
      "micro_batch_size": 10,
      "prefect": {
        "batch_execution": {
          "strategy": "work-pool-kubernetes",
          "work_pool_name": "datasift-k8s-pool",
          "image": "datasift-opensource:latest",
          "image_pull_policy": "Never",
          "namespace": "datasift",
          "service_account_name": "prefect-worker",
          "finished_job_ttl": 3600,
          "pod_watch_timeout_seconds": 300,
          "stream_output": true,
          "cpu_request": "1000m",
          "cpu_limit": "2000m",
          "memory_request": "2Gi",
          "memory_limit": "4Gi",
          "env": {
            "AWS_ACCESS_KEY_ID": "YOUR_AWS_ACCESS_KEY_ID",
            "AWS_SECRET_ACCESS_KEY": "YOUR_AWS_SECRET_ACCESS_KEY",
            "AWS_ENDPOINT_URL": "http://datasift-worker1.fyre.ibm.com:9000",
            "AWS_REGION": "us-east-1",
            "OLLAMA_HOST": "http://datasift-worker1.fyre.ibm.com:11434",
            "DOCLING_SERVE_URL": "http://datasift-worker1.fyre.ibm.com:30501",
            "OPENSEARCH_HOST": "datasift-worker1.fyre.ibm.com",
            "OPENSEARCH_PORT": "9200",
            "OPENSEARCH_USERNAME": "admin",
            "OPENSEARCH_PASSWORD": "YOUR_OPENSEARCH_PASSWORD",
            "OPENSEARCH_USE_SSL": "false",
            "OPENSEARCH_VERIFY_CERTS": "false"
          },
          "batch_storage": {
            "type": "s3",
            "bucket": "datasift-batches",
            "prefix": "tmp/batches/",
            "endpoint_url": "http://datasift-worker1.fyre.ibm.com:9000",
            "access_key_id": "YOUR_S3_ACCESS_KEY_ID",
            "secret_access_key": "YOUR_S3_SECRET_ACCESS_KEY",
            "region": "us-east-1"
          }
        }
      }
    },
    "dag": [
      {
        "id": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd",
        "name": "ingest",
        "operator": "ingest_source",
        "config": {
          "provider": "s3",
          "credentials": {
            "access_key": "YOUR_AWS_ACCESS_KEY",
            "secret_key": "YOUR_AWS_SECRET_KEY"
          },
          "connection_params": {
            "bucket": "tm-wkc-storage-1",
            "prefix": "/election_100_txt_files"
          },
          "include_filter": "txt",
          "max_files": 100,
          "force_ingest": true
        },
        "input_edges": [],
        "output_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ]
      },
      {
        "id": "7cfd7577-b061-4fc9-92d5-120ae0fbde89",
        "name": "extract",
        "operator": "extract_docling",
        "config": {
          "doc_column": "content",
          "max_workers": 4,
          "docling_serve_ocr_engine": "tesserocr"
        },
        "input_edges": [
          {
            "node_id_ref": "30953cfb-a3a2-4688-9aea-ff9fff10f7bd"
          }
        ],
        "output_edges": [
          {
            "node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"
          }
        ]
      },
      {
        "id": "6101c752-523e-4a4a-84e2-81e0b2109129",
        "name": "chunk",
        "operator": "chunker",
        "config": {
          "chunk_type": "hybrid",
          "doc_column": "content",
          "chunk_size": 512,
          "chunk_overlap": 128,
          "retain_original_content": false
        },
        "input_edges": [
          {
            "node_id_ref": "7cfd7577-b061-4fc9-92d5-120ae0fbde89"
          }
        ],
        "output_edges": [
          "6de879bd-bbe0-4d60-998f-031f65472a02"
        ]
      },
      {
        "id": "6de879bd-bbe0-4d60-998f-031f65472a02",
        "name": "embeddings",
        "operator": "embeddings",
        "config": {
          "embeddings_type": "ollama",
          "embeddings_model_id": "granite4",
          "embeddings_column": "embeddings",
          "overlap_ratio": 0.2,
          "doc_column": "content"
        },
        "input_edges": [
          {
            "node_id_ref": "6101c752-523e-4a4a-84e2-81e0b2109129"
          }
        ],
        "output_edges": [
          "87249dbf-4a1a-433a-91da-ee5fb3244284"
        ]
      },
      {
        "id": "87249dbf-4a1a-433a-91da-ee5fb3244284",
        "name": "vectordb",
        "operator": "vectordb",
        "config": {
          "provider": "opensearch",
          "index_name": "invoices_k8s_test",
          "doc_id_column": "doc_id_hash",
          "embeddings_column": "embeddings",
          "vector_dimension": 384,
          "create_index": true,
          "batch_size": 100,
          "provider_config": {
            "host": "datasift-worker1.fyre.ibm.com",
            "port": 9200,
            "username": "admin",
            "password": "MyStrongPass123!",
            "use_ssl": false,
            "verify_certs": false,
            "engine": "faiss",
            "algorithm": "hnsw",
            "space_type": "l2"
          },
          "available_features": {
            "doc_id_hash": {
              "name": "Document ID",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "string",
              "is_primary": true
            },
            "content": {
              "name": "Content",
              "available_for_vector_db": true,
              "type": "string"
            },
            "embeddings": {
              "name": "Embeddings",
              "available_for_vector_db": true,
              "mandatory_for_vector_db": true,
              "type": "vector"
            },
            "extracted_invoice_number": {
              "name": "Invoice Number",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_invoice_date": {
              "name": "Invoice Date",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_vendor_name": {
              "name": "Vendor Name",
              "available_for_vector_db": true,
              "type": "string"
            },
            "extracted_grand_total": {
              "name": "Grand Total",
              "available_for_vector_db": true,
              "type": "float"
            }
          },
          "feature_mappings": {
            "doc_id_hash": "pk",
            "content": "text",
            "embeddings": "vector_embeddings",
            "extracted_invoice_number": "invoice_number",
            "extracted_invoice_date": "invoice_date",
            "extracted_vendor_name": "vendor_name",
            "extracted_grand_total": "grand_total"
          }
        },
        "input_edges": [
          {
            "node_id_ref": "6de879bd-bbe0-4d60-998f-031f65472a02"
          }
        ],
        "output_edges": []
      }
    ]
  }
}